module logic_gates(
    input logic a, b,
    output logic f_not, f_and, f_or, f_xor, f_nand, f_nor
);
    assign f_not = ~a;
    assign f_and = a & b;
    assign f_or = a | b;
    assign f_xor = a ^ b;
    assign f_nand = ~(a & b);
    assign f_nor = ~(a | b);
endmodule


module parity(
	input logic [63:0] a,
	output logic parity_result
);

    assign parity_result = ~^a;

endmodule


module truth_table(
    input logic a, b, c,
    output logic f
);

    assign f = ~b | (a & ~c);
    // F = B' + AC'

endmodule


module comparator4bit(
	input logic a3, a2, a1, a0,  // Inputs a and b are split up for some reason
	input logic b3, b2, b1, b0,  // Let's combine them using concatenation!
	output logic eq, gt, lt
);

    logic [3:0] a, b;
	assign a = {a3, a2, a1, a0};
    assign b  = {b3, b2, b1, b0};
    assign eq = (a == b);
    assign gt = (a > b);
    assign lt = (a < b);

endmodule

module sign_extension(
	input logic [6:0] a,
	output logic [15:0] y
);

	assign y = {{9{a[6]}}, a};

endmodule

module mux2(
	input logic [3:0] d0, d1,
	input logic s,
	output logic [3:0] y
);

    assign y = s ? d1 : d0;

endmodule

module mux4(
	input logic [3:0] d0, d1, d2, d3,
	input logic [1:0] s,
	output logic [3:0] y
);

	logic [3:0] low, high;

	mux2 lowmux(d0, d1, s[0], low);
	mux2 highmux(d2, d3, s[0], high);
	mux2 finalmux(low, high, s[1], y);

endmodule

module priority_casez(
    input logic [3:0] a,
    output logic [3:0] y
);

    always_comb begin
        casez (a)
            4'b1???: y = 4'b1000;
            4'b01??: y = 4'b0100;
            4'b001?: y = 4'b0010;
            4'b0001: y = 4'b0001;
            default: y = 4'b0000;
        endcase
    end

endmodule

